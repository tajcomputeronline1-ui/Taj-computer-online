<script>
const services = [
"APAAR ID कार्ड","पैन कार्ड","आयुष्मान कार्ड","वोटर कार्ड",
"संबल कार्ड","ई-श्रम कार्ड","सीनियर सिटीजन कार्ड","UIDAI / आधार सेवाएँ",
"RC कार्ड प्रिंट","DL कार्ड प्रिंट","आधार कार्ड प्रिंट","राशन कार्ड प्रिंट",
"PVC कार्ड प्रिंट","Farmer ID कार्ड","किसान पंजीयन","रोजगार पंजीयन",
"व्यापम / MPESB पंजीयन","MP TAASC पंजीयन","सभी प्रकार के स्कॉलरशिप फॉर्म",
"रिजल्ट प्रिंट / टाइपिंग","Food / FSSAI लाइसेंस","गुमास्ता लाइसेंस",
"ड्राइविंग लाइसेंस आवेदन","जीवन प्रमाण पत्र","पासपोर्ट आवेदन",
"उद्यम रजिस्ट्रेशन","MP Board फॉर्म","I-Form आवेदन","CPCT फॉर्म",
"रेलवे फॉर्म","नवोदय फॉर्म","स्कूल मैपिंग कार्य","स्टूडेंट प्रोफाइल अपडेट",
"UDISE कार्य","हिंदी / अंग्रेज़ी टाइपिंग","RTE फॉर्म","PF Withdrawal",
"Photoshoot","कार / वेडिंग पोस्टर","फोटोकॉपी / प्रिंटआउट",
"लैमिनेशन","स्कैनिंग","बिजली बिल भुगतान","LIC प्रीमियम भुगतान",
"वाहन बीमा","आयकर रिटर्न (ITR)","NEET / JEE फॉर्म","कॉलेज फॉर्म",
"AEPS सेवा","समग्र ID","बैंक स्टेटमेंट","NGO / संस्था पंजीयन",
"T-shirt / Mug / Gift Printing","स्पाइरल बाइंडिंग","फोटो फ्रेम / एल्बम",
"कंप्यूटर क्लासेस","HTML / CSS / Bootstrap",
"Photoshop / Graphic Designing","DCA / PGDCA"
];

const list = document.getElementById("serviceList");

function showServices(items) {
  list.innerHTML = "";
  items.forEach(name => {
    const div = document.createElement("div");
    div.className = "card";
    const h = document.createElement("h3");
    h.textContent = name;
    const p = document.createElement("p");
    p.textContent = "इस सेवा की जानकारी और आवश्यक दस्तावेजों के लिए WhatsApp पर संपर्क करें।";
    const a = document.createElement("a");
    a.className = "btn";
    a.textContent = "पूछताछ करें";
    a.href = "https://wa.me/919669370386?text=" + encodeURIComponent("मुझे " + name + " सेवा की जानकारी चाहिए।");
    a.target = "_blank";
    div.append(h,p,a);
    list.appendChild(div);
  });
}

showServices(services);

document.getElementById("search").addEventListener("input", function() {
  const q = this.value.toLowerCase();
  showServices(services.filter(s => s.toLowerCase().includes(q)));
});

document.getElementById("contactForm").addEventListener("submit", function(e) {
  e.preventDefault();
  const name = document.getElementById("customerName").value;
  const phone = document.getElementById("customerPhone").value;
  const service = document.getElementById("customerService").value;
  const message = document.getElementById("customerMessage").value;
  const text = "नया ग्राहक संपर्क:\nनाम: " + name +
    "\nमोबाइल: " + phone +
    "\nसेवा: " + service +
    "\nसंदेश: " + message;
  window.open("https://wa.me/919669370386?text=" + encodeURIComponent(text), "_blank");
});
</script>

