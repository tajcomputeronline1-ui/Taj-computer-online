  div.className="service";
  const title=document.createElement("h3");
  title.textContent=service;
  const link=document.createElement("a");
  link.href="https://wa.me/919669370386?text="+encodeURIComponent("नमस्ते, मुझे "+service+" सेवा के बारे में जानकारी चाहिए।");
  link.target="_blank";
  link.rel="noopener";
  link.textContent="पूछताछ करें →";
  div.append(title,link);
  list.appendChild(div);
 });
}
function filterServices(){
 const q=document.getElementById("search").value.toLowerCase();
 showServices(services.filter(s=>s.toLowerCase().includes(q)));
}
